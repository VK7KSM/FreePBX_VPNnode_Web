<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/titleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/title_pair"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/codeView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/code_bg"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusedByDefault="true"
        android:fontFamily="monospace"
        android:gravity="center"
        android:nextFocusDown="@id/renewButton"
        android:text="---  ---"
        android:textColor="#FACC15"
        android:textSize="42sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:text="@string/how_to_pair"
        android:textColor="#E2E8F0"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/permView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <Button
        android:id="@+id/renewButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/btn_bg"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:nextFocusUp="@id/codeView"
        android:nextFocusDown="@id/permButton"
        android:text="@string/renew_code"
        android:textColor="@color/btn_text"
        android:textSize="14sp" />

    <Button
        android:id="@+id/permButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/btn_bg"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:nextFocusUp="@id/renewButton"
        android:nextFocusDown="@id/reportButton"
        android:text="@string/grant_perms"
        android:textColor="@color/btn_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/reportButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/btn_bg"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:nextFocusUp="@id/permButton"
        android:text="@string/report_now"
        android:textColor="@color/btn_text"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
