{
  "name": "freepbx-vpnnode-web",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "vars": { "PANEL_KV_ENABLED": "1" },
  "assets": {
    "directory": "./.generated-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sub*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "triggers": { "crons": ["* * * * *"] },
  "r2_buckets": [
    { "binding": "ELF_ARTIFACTS", "bucket_name": "elfremote-private" }
  ],
  "kv_namespaces": [
    {
      "binding": "SUB_STORE_KV",
      "id": "833409e1f96d4ef28334811dfec66b52"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ELF_DO", "class_name": "ElfStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ElfStore"] }
  ]
}
