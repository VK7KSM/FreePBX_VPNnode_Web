{
  "name": "elfremote",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  // 必须保持 false。workers.dev 是公开地址，任何人都能访问，开着就会被扫描和刷量；
  // 2026-09-17 与 09-19 两次 Worker 被 Cloudflare 以滥用为由停用都和它有关。
  // 对外服务只走自定义域 v.elfradio.net，自定义域与这个开关互不影响，关掉不影响正常访问。
  "workers_dev": false,
  "vars": { "PANEL_KV_ENABLED": "1", "CF_USAGE_ENABLED": "1" },
  "assets": {
    "directory": "./.generated-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sub*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "triggers": { "crons": ["* * * * *"] },
  "r2_buckets": [
    { "binding": "ELF_ARTIFACTS", "bucket_name": "elfremote-private" }
  ],
  "kv_namespaces": [
    {
      "binding": "SUB_STORE_KV",
      "id": "833409e1f96d4ef28334811dfec66b52"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ELF_DO", "class_name": "ElfStore" },
      { "name": "ELF_DO_LEGACY", "class_name": "ElfStoreLegacy" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ElfStore"] },
    { "tag": "v2", "transferred_classes": [ { "from": "ElfStore", "from_script": "freepbx-vpnnode-web", "to": "ElfStoreLegacy" } ] }
  ]
}
