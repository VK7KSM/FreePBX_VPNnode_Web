# Node.js 与 Cloudflare 本地构建目录
node_modules/
.wrangler/
.generated-assets/
.generated-assets-proxy/
dist/
build/
coverage/

# 本地凭据与签名材料
.dev.vars
.env
.env.*
*.token
*.jks
*.keystore
keystore.properties
local.properties

# 本地测试、夹具与测试报告
*.test.mjs
*.spec.mjs
test-*.ps1
test-local-worker.mjs
test-support.mjs
test-fixtures/
.github/workflows/test.yml
test-results/
playwright-report/
.playwright-cli/
.pytest_cache/
__pycache__/

# 项目文档、方案、草稿与临时工作区不进入 Web 发布仓库
*.md
# MCP 说明文档要嵌进 Worker 供网页与 AI 读取，是代码的一部分，不是项目文档
!mcp-guide.md
docs/
draft/
scratch/
staging/

# Pixel Gateway 是本仓库内的 SIP 系统源码，允许维护其文档
!gsm-sip-gateway/**/*.md
!gsm-sip-gateway/docs/
!gsm-sip-gateway/docs/**

# 大阪 SIP 服务器备份是可部署源码，允许维护其文档
!sip-server/**/*.md

# 非 Cloudflare Worker 子项目
mqtt-server/
tools/
# D22 elfRemote 客户端源码随公开仓库发布；构建产物、本机配置与制品仍由下方规则与 elfRemote/.gitignore 排除。
elfRemote/*
!elfRemote/control-plane.js
!elfRemote/app/
!elfRemote/tools/
!elfRemote/docs/
!elfRemote/gradle/
!elfRemote/art/
!elfRemote/build.gradle
!elfRemote/settings.gradle
!elfRemote/gradle.properties
!elfRemote/version.properties
!elfRemote/package.json
!elfRemote/gradlew
!elfRemote/gradlew.bat
!elfRemote/README.md
!elfRemote/.gitignore
!elfRemote/*.test.mjs
!elfRemote/*.md
!elfRemote/**/*.md
elfRemote/app/build/
elfRemote/.gradle/
elfRemote/local.properties
elfRemote/captures/
scripts/*
!scripts/collect-cf-usage.mjs

# 设备、固件、日志与本地发布制品
*.apk
*.aab
*.aar
*.so
*.jar
*.img
*.bin
*.log
*.tmp
captures/
artifacts/
releases/

# Pixel Gateway 构建所需的受控本地库与 Gradle wrapper
!gsm-sip-gateway/**/*.so
!gsm-sip-gateway/gradle/wrapper/*.jar

# 旧配置已由 wrangler.jsonc 取代
wrangler.toml

# 操作系统与编辑器文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
