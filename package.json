{
  "name": "freepbx-vpnnode-web",
  "version": "2.5.0",
  "private": true,
  "scripts": {
    "deploy": "npm run build:assets && wrangler deploy --config wrangler.jsonc",
    "build:assets": "node build-static-assets.mjs",
    "embed:devices-client": "node embed-devices-client.mjs",
    "embed:check": "node embed-devices-client.mjs --check",
    "build:assets:proxy": "node build-static-assets.mjs && node build-proxy-assets.mjs",
    "deploy:proxy": "npm run build:assets:proxy && wrangler deploy --config wrangler.s.jsonc"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.3",
    "@yume-chan/stream-extra": "2.5.3",
    "qrcode-generator": "2.0.4"
  }
}
