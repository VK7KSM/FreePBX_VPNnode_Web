# 复制为 secrets.env 后再执行 install.sh。不要把 secrets.env 提交进 Git。

SIP_DOMAIN=sip.elfradio.net
PUBLIC_IP=0.0.0.0

# 必须与面板 KV 里的 sip_heartbeat_token 完全一致
HEARTBEAT_TOKEN=

# Fail2Ban 永不封这些地址，空格分隔。至少保留本机。
IGNOREIP=127.0.0.1/8 ::1

# TLS 证书（Let's Encrypt 或已有文件）
CERT_FULLCHAIN=/etc/asterisk/keys/sip.elfradio.net-fullchain.crt
CERT_KEY=/etc/asterisk/keys/sip.elfradio.net.key
